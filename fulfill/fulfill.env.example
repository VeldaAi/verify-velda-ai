# Copy to /home/quizmynotes/verify-fulfill/fulfill.env on the server.
# Never commit the filled-in file. Values already set in the environment win.
# Leave values unquoted. COOKIE_SECRET is optional; when it is empty the
# access cookie is signed with a key derived from the Stripe webhook secret.
#
# A manual 4-hour pass:
#   python3 verify_fulfill.py mint --plan diy_100 --email verify@velda.ai --name "Jason"

BIND_HOST=127.0.0.1
BIND_PORT=8095
STRIPE_WEBHOOK_SECRET=
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=verify@velda.ai
SMTP_PASSWORD=
FROM_NAME=Get App Verified
BCC_EMAIL=verify@velda.ai
PACKS_DIR=/home/quizmynotes/verify-fulfill/packs
STATE_DB=/home/quizmynotes/verify-fulfill/grants.db
COOKIE_SECRET=
